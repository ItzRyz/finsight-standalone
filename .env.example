# Database — Prisma 7 requires both (pooler for app, direct for migrations/seed)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# App URL — used for email confirm / password reset redirects (auth.ts)
# Either NEXT_PUBLIC_APP_URL or legacy NEXT_PUBLIC_SITE_URL is accepted; APP_URL takes precedence.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed — Supabase auth user id to attach sample data to
SEED_USER_ID="00000000-0000-0000-0000-000000000000"
