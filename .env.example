# Database — Prisma 7 requires both (pooler for app, direct for migrations/seed)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# App URL — used for email confirm / password reset redirects (auth.ts)
# Either NEXT_PUBLIC_APP_URL or legacy NEXT_PUBLIC_SITE_URL is accepted; APP_URL takes precedence.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed — Supabase auth user id to attach sample data to
SEED_USER_ID="00000000-0000-0000-0000-000000000000"

# Currency rates — exchangerate-api.com (server-only, optional; fallback static rates used if missing)
EXCHANGERATE_API_KEY=""

# Test DB for CI/local integration tests (docker-compose postgres_test 5433)
DATABASE_URL_TEST="postgresql://finsight_test:finsight_test@localhost:5433/finsight_test"
DIRECT_URL_TEST="postgresql://finsight_test:finsight_test@localhost:5433/finsight_test"

# Storage — Supabase buckets `receipts` (public) + `avatars` (public) — created via migration 20260828140000 or dashboard
# Receipts are public read per user request (anyone with URL can view)
